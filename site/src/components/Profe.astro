---
const wa = 'https://wa.me/5491131074612?text=Hola%20Gerardo%2C%20quiero%20consultar%20por%20las%20clases';
---
<section id="profe">
  <div class="wrap grid gap-8 items-center min-[820px]:grid-cols-[1fr_1.1fr]">
    <div class="grid grid-cols-2 gap-3">
      <img src="/img/profe.jpg" alt="Sabum Nim Gerardo Palauro con alumnas y certificados" width="1080" height="1080" loading="lazy" decoding="async" class="rounded-xl" style="width:100%;height:auto;object-fit:cover;aspect-ratio:4/5" />
      <img src="/img/profe-2.jpg" alt="Gerardo Palauro corrigiendo una técnica en clase" width="1080" height="1080" loading="lazy" decoding="async" class="rounded-xl" style="width:100%;height:auto;object-fit:cover;aspect-ratio:4/5" />
    </div>
    <div>
      <span class="eyebrow">Instructor</span>
      <h2 class="disp">Gerardo Palauro</h2>
      <p class="sub">Sabum Nim Gerardo Palauro (IV Dan ITF), director de la Escuela de Taekwon-Do
      ITF ATRA Sáenz Peña. Dicta clases en Villa Lynch y Loma Hermosa, para chicos desde los 4 años,
      adolescentes y adultos.</p>
      <p class="sub">La escuela forma parte de la Asociación Taekwon-Do República Argentina (ATRA)
      y trabaja con exámenes, torneos y actividades para toda la familia.</p>
      <a class="btn mt-6" href={wa} target="_blank" rel="noopener">Escribirle a Gerardo</a>
    </div>
  </div>
</section>

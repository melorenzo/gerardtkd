---
import KickAnimation from './KickAnimation';
import HeroAnimated from './HeroAnimated';
---
<div class="hero" id="top">
  <div class="bg"><img src="/img/hero.jpg" alt="Entrenamiento de Taekwon-Do en el dojo" fetchpriority="high" width="1080" height="980" /></div>
  <div class="wrap in">
    <div class="flex items-start justify-between gap-6 flex-wrap">
      <div class="min-w-0">
        <HeroAnimated client:load />
      </div>
      <div class="pt-2 sm:pt-8 opacity-95 shrink-0 self-center">
        <KickAnimation client:load />
      </div>
    </div>
  </div>
</div>
<style>
  .hero{position:relative;border-bottom:1px solid var(--line);overflow:hidden}
  .hero .bg{position:absolute;inset:0}
  .hero .bg img{width:100%;height:100%;object-fit:cover;opacity:.34}
  .hero .bg:after{content:"";position:absolute;inset:0;
    background:linear-gradient(180deg,rgba(11,13,17,.55) 0%,rgba(11,13,17,.86) 70%,var(--bg) 100%)}
  .hero .in{position:relative;padding:104px 22px 92px}
  @media(max-width:700px){
    .hero .bg{position:static}
    .hero .bg img{height:auto;aspect-ratio:4/3;object-fit:cover;opacity:1}
    .hero .bg:after{display:none}
    .hero .in{padding:30px 22px 74px}
  }
  h1{font-size:clamp(38px,8vw,74px);margin-top:14px;max-width:15ch}
  h1 em{font-style:normal;color:var(--ac)}
  .lede{color:var(--dim);font-size:17.5px;margin-top:24px;max-width:52ch;line-height:1.6}
</style>
